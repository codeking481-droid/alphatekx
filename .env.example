# Add these browser-safe values in Render Dashboard > Environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_PUBLIC_APP_URL=https://alphatekx.name.ng

# Add these server-only secrets in Render Dashboard > Environment.
# Never prefix server secrets with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. A stable 32+ character secret used to encrypt user-supplied keys.
# When omitted, the server derives encryption from SUPABASE_SERVICE_ROLE_KEY.
API_KEY_ENCRYPTION_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CHECKOUT_CURRENCY=NGN
# Current checkout conversion used when USD catalog prices are collected in NGN.
PAYSTACK_NGN_PER_USD=1600
PAYSTACK_CALLBACK_URL=https://alphatekx.name.ng/settings
OPENAI_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=
ALPHA_API_URL=/api/alpha
PUBLIC_APP_URL=https://alphatekx.name.ng
DEVICE_FINGERPRINT_SECRET=
# Comma-separated authenticated Google emails allowed to bypass device claims.
SUPER_ADMIN_EMAILS=

# Google Cloud OAuth web client. Enable Gmail API and register the callback exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://alphatekx.name.ng/auth/google/callback
# Optional separate signing secret for short-lived OAuth state values.
OAUTH_STATE_SECRET=

# Meta OAuth app. Add this exact URI under Facebook Login > Valid OAuth Redirect URIs.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://alphatekx.name.ng/api/connectors/facebook/callback
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
# Comma-separated E.164 test numbers without spaces. Keep server-side only.
WHATSAPP_ALLOWED_RECIPIENTS=

# Composio account OAuth for the nine managed tools.
# The IDs come from Composio Auth Configs; app client IDs/secrets alone are
# not interchangeable with an auth-config ID.
COMPOSIO_API_KEY=
COMPOSIO_APP_NAME=alphatekx
COMPOSIO_GMAIL_AUTH_ID=ac_K0fpEcRPTCJL
COMPOSIO_GITHUB_AUTH_ID=ac_gZz4pPc0m1Th
COMPOSIO_GOOGLEDOCS_AUTH_ID=ac_P6J_UNItatfh
COMPOSIO_YOUTUBE_AUTH_ID=ac_sEDBieVAsSvc
COMPOSIO_DISCORD_AUTH_ID=ac_2aNBLsdLANIy
COMPOSIO_SHEETS_AUTH_ID=ac_u_Si-U1KyWyg
COMPOSIO_WHATSAPP_AUTH_CONFIG_ID=ac_mVq6qm6ivr3x
COMPOSIO_FACEBOOK_AUTH_CONFIG_ID=ac_KxXKh4E240Vi
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=ac_0Lzm_WFhC38W
COMPOSIO_TWITTER_AUTH_CONFIG_ID=ac_75GBYAXRovfm
# Optional Composio-managed providers:
COMPOSIO_NOTION_AUTH_CONFIG_ID=ac_HqEFw9-1J160
CEO_WATCHER_ENABLED=false
# Optional Google Sheets order source used by Level 3 CEO monitoring.
CEO_ORDERS_SPREADSHEET_ID=
CEO_ORDERS_RANGE=Sheet1!A:Z
# Native LinkedIn OAuth remains the production personal-profile publisher.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://alphatekx.name.ng/api/linkedin/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://alphatekx.name.ng/api/tiktok/callback
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REDIRECT_URI=https://alphatekx.name.ng/api/snapchat/callback
# For custom Meta/Instagram OAuth, register this exact redirect URI in both
# the provider dashboard and the matching Composio Auth Config:
# https://alphatekx.name.ng/api/composio/callback
# YouTube consent-screen verification is controlled by the selected Google
# OAuth client. Prefer a Composio-managed Auth Config during testing, or submit
# the custom AlphaTekx Google OAuth client for verification before public use.
PEXELS_API_KEY=
POLLINATIONS_API_KEY=
POLLINATIONS_TEXT_MODEL=openai-fast
