# Add these browser-safe values in Render Dashboard > Environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_PUBLIC_APP_URL=https://alphatekx.name.ng
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Add these server-only secrets in Render Dashboard > Environment.
# Never prefix server secrets with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. A stable 32+ character secret used to encrypt user-supplied keys.
# When omitted, the server derives encryption from SUPABASE_SERVICE_ROLE_KEY.
API_KEY_ENCRYPTION_KEY=
PAYSTACK_SECRET_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=
ALPHA_API_URL=/api/alpha
PUBLIC_APP_URL=https://alphatekx.name.ng
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternatively provide these three values instead of FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google Cloud OAuth web client. Enable Gmail API and register the callback exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://alphatekx.name.ng/auth/google/callback
# Optional separate signing secret for short-lived OAuth state values.
OAUTH_STATE_SECRET=

# Meta OAuth app. Add this exact URI under Facebook Login > Valid OAuth Redirect URIs.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://alphatekx.name.ng/api/connectors/facebook/callback
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=
# Comma-separated E.164 test numbers without spaces. Keep server-side only.
WHATSAPP_ALLOWED_RECIPIENTS=

# Composio account OAuth. Instagram and X use these auth-config IDs.
# The IDs come from Composio Auth Configs; app client IDs/secrets alone are
# not interchangeable with an auth-config ID.
COMPOSIO_API_KEY=
COMPOSIO_INSTAGRAM_AUTH_CONFIG_ID=
COMPOSIO_TWITTER_AUTH_CONFIG_ID=
# Accepted alias for X:
COMPOSIO_X_AUTH_CONFIG_ID=
# Optional Composio-managed providers:
COMPOSIO_NOTION_AUTH_CONFIG_ID=
COMPOSIO_YOUTUBE_AUTH_CONFIG_ID=
