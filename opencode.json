{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "alphatekx",
  "model": "anthropic/claude-sonnet-4-6",
  "agent": {
    "alphatekx": {
      "description": "AlphaTekx AI Employee - Plans work, executes approved tasks, continues offline, and reports back with visible chain of thought.",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "allow",
        "bash": "allow",
